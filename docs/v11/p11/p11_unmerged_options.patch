+T2)  # GPU ~6 min: qc_fine default identity on the shipped run (live tree vs tree under test, both fresh, both written under $T)
+  step T2_qc_live gpu python $LIVE/scripts/qc_fine.py --work $W --run $R5 --out $T/qc_ident_live
+  step T2_qc_new gpu python $S/qc_fine.py --work $W --run $R5 --out $T/qc_ident_new
+  step T2_compare cpu python $S/p11_impl_check.py json-identity $T/qc_ident_live/qc_fine.json $T/qc_ident_new/qc_fine.json ;;
+T3)  # GPU ~6 min: body block reproduces probe:exclude qc/body_A and qc/noexcl_A (same 8 poses; P_R5 = final via --T and an empty run dir)
+  mkdir -p $T/empty_run
+  step T3_qc_bodyA gpu python $S/qc_fine.py --work $W --run $T/empty_run --T $P_R5 --out $T/qc_bodyA $QC_MASKS \
+       --pose polish_b=$RUNS_IN/I58_polish_b/T_oct2mri_fine_candidate.npy --pose V1_rigid=$EX/runs/V1/T_rigid_from_P_R5.npy --pose V1_affine=$EX/runs/V1/T_affine_from_P_R5.npy \
+       --pose V1z_rigid=$EX/runs/V1z/T_rigid_from_P_R5.npy --pose V2_rigid=$EX/runs/V2/T_rigid_from_P_R5.npy --pose V3_affine=$EX/runs/V3/T_affine_from_P_R5.npy \
+       --pose P7_bodyB=work/probe_xr/pieces/T_body_rigid_R5_best.npy
+  step T3_compare cpu python $S/p11_impl_check.py body-repro --qc $T/qc_bodyA/qc_fine.json --probe-body $EX/qc/body_A/qc_body.json --probe-noexcl $EX/qc/noexcl_A/qc_body.json ;;
+T4)  # GPU ~2 min: renorm_prep.py rebuilds the native prep's oct150 from its octv byte-identically (no options, nothing written); CPU ~3 min:
+     # gain-insensitivity of the stripe-axis detection on real data (un-destriped v1 octv with and without the axis-0 correction; must be axis 2 both times)
+  step T4_renorm_identity gpu python $S/renorm_prep.py --work $W --check-identity
+  step T4_detect_order cpu python $S/p11_impl_check.py detect-order --octv work/xiangrui_I58bs/octv.npy --mask-work $W --fac $NORM/factors.npz --expect-axis 2 ;;
