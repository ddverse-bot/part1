+check("Q1_extra_pose", Q1 is not None and "alt" in Q1["boundary"] and "alt_vs_final" in Q1["pose_diffs"] and abs(fr(Q1, "final") - fr(Qd, "final")) <= 0.05 and abs(fr(Q1, "final", "reverse_mri_to_oct") - fr(Qd, "final", "reverse_mri_to_oct")) <= 0.05,
+      final_fwd_default_vs_pose=[fr(Qd, "final"), fr(Q1, "final") if Q1 else None], alt_fwd=fr(Q1, "alt") if Q1 else None)
+
+Q2, _ = qc("opt_empty_excl")
+ok2 = Q2 is not None and set(Q2["boundary_body"]) == set(Q2["T_used"])
+if ok2:
+    for nm in Q2["T_used"]:
+        for d in ("forward_oct_to_mri", "reverse_mri_to_oct"):
+            for part in ("overall", "rim_faces", "deep_end"):
+                ok2 &= Q2["boundary_body"][nm][d][part] == Q2["boundary"][nm][d][part]
+    for nm, L in Q2["mi_landscape"].items():
