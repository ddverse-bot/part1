+check("T6d_weak_axis_borrows_period", info6d["applied"] and bor is not None and "axis_a_from_axis_b" in bor and abs(info6d["periods_vox"][0] / P0 - 1) < 0.02, borrowed=bor, periods=info6d.get("periods_vox"))
