+    same = np.array_equal(o_ax, np.moveaxis(o_t, 0, ax)) and np.array_equal(np.asarray(i_ax["scale"]), np.asarray(i_t["scale"]))
+    def pmed(v):
+        out = []
+        for i in range(v.shape[ax]):
+            p = np.take(v, i, axis=ax).astype(np.float32); p = p[p > 0]; out.append(np.median(p) if p.size > 2000 else np.nan)
+        return np.asarray(out, float)
+    hp = []
+    for v in (raw, o_ax):
+        r = pmed(v); ok = np.isfinite(r); lr = np.log(r[ok]); hp.append(float(np.std(lr - ndimage.uniform_filter1d(lr, 15, mode="nearest"))))
+    check(f"T2_axis{ax}_equals_transposed_axis0_and_flattens", same and hp[1] < 0.5 * hp[0], transposed_identical=same, hp_std_log_median_before_after=hp)
+
+# ---------------------------------------------------------------- T3
+raw = raw_volume((50, 60, 70), 0.002)
+o_v1, i_v1 = oct_slab_normalize(raw, tissue_thresh=0.00096, window=20, out_dtype=np.float16)
+o_g, i_g = octnorm.slab_normalize(raw, axis=0, tissue_thresh=0.00096, window=20, out_dtype=np.float16, gain_only=True)
+exp = np.clip(raw * np.float32(i_g["gain"]), 0, 60000.0).astype(np.float16)
+check("T3_gain_only", np.all(np.asarray(i_g["scale"]) == 1) and i_g["gain"] == i_v1["gain"] and np.array_equal(o_g, exp), gain=i_g["gain"])
+
+# ---------------------------------------------------------------- T4
+raw = raw_volume((50, 60, 70), 0.002)
+o_a, _ = octnorm.slab_normalize(raw, axis=0, tissue_thresh=0.00096, window=20, out_dtype=np.float16, floor="abs")
+o_r, _ = octnorm.slab_normalize(raw, axis=0, tissue_thresh=0.00096, window=20, out_dtype=np.float16, floor="rel")
+low = raw_volume((50, 60, 70), 0.0006)                                                  # medians ~0.0006-0.0008: below v1's absolute floor
+_, ia = octnorm.slab_normalize(low, axis=0, tissue_thresh=0.0002, window=20, out_dtype=np.float32, floor="abs")
+_, ir = octnorm.slab_normalize(low, axis=0, tissue_thresh=0.0002, window=20, out_dtype=np.float32, floor="rel")
+check("T4_floor", np.array_equal(o_a, o_r) and np.all(np.asarray(ia["scale"]) == 1) and np.std(ir["scale"]) > 0.01 and ia["n_planes_at_floor"] > 0 and ir["n_planes_at_floor"] == 0,
+      abs_planes_at_floor=ia["n_planes_at_floor"], rel_scale_std=float(np.std(ir["scale"])))
+
+# ---------------------------------------------------------------- T5
+Z, Y, X = 90, 110, 160
+base = ndimage.gaussian_filter(rng.normal(size=(Z, Y, X)).astype(np.float32), 3.0); base = 16000 * np.exp(0.25 * base / base.std())
+k = np.arange(X); g = 1 + 0.04 * ((k % 7.5) / 7.5 - 0.5) + 0.02 * np.sin(2 * np.pi * k / 40)
+vol = np.clip(base * g[None, None, :], 1, 60000).astype(np.float16); vol[rng.random(vol.shape) < 0.05] = 0; zeros0 = vol == 0
+mask = np.zeros(vol.shape, bool); mask[5:-5, 8:-8, :] = True
+med_before, _ = octnorm.plane_medians(vol, 2, mask); exact = float(np.median(vol[:, :, 17].astype(np.float32)[(vol[:, :, 17] > 0) & mask[:, :, 17]]))
+info5 = octnorm.plane_normalize_inplace(vol, axis=2, window=30, mask=mask)
+med_after, _ = octnorm.plane_medians(vol, 2, mask)
+r_b = profile_residual(med_before, 30)[0]["resid_std"]; r_a = profile_residual(med_after, 30)[0]["resid_std"]
+nz = vol[vol > 0].astype(np.float32)
+check("T5_plane_normalize", info5["applied"] and r_a < 0.2 * r_b and np.array_equal(vol == 0, zeros0) and nz.min() >= 1 and nz.max() <= 60000 and med_before[17] == exact,
+      resid_std_before_after=[r_b, r_a], std_log_fac=info5["std_log_fac"], period=info5["dominant_period_planes"])
+
+# ---------------------------------------------------------------- T6
+N0, N1, NS = 728, 1006, 8; P0, P1 = 70.44, 69.72                                         # the I58 octv en-face size and tile periods
+yy, xx = np.meshgrid(np.arange(N0), np.arange(N1), indexing="ij"); ph0 = (yy / P0) % 1.0; ph1 = (xx / P1) % 1.0
+F_true = (0.02 * np.cos(2 * np.pi * ph0) + 0.02 * np.cos(2 * np.pi * 2 * ph0) + 0.025 * np.cos(2 * np.pi * ph1) + 0.015 * np.cos(2 * np.pi * ph0) * np.cos(2 * np.pi * ph1)
+          + 0.01 * np.sin(2 * np.pi * 2 * ph1) + 0.015 * ((ph0 < 0.5) & (ph1 < 0.5)))           # alternating (fundamental = 2 x step), non-separable
+anat = ndimage.gaussian_filter(rng.normal(size=(N0, N1, NS)).astype(np.float32), (3, 3, 1)); anat = 16000 * np.exp(0.25 * anat / anat.std())
