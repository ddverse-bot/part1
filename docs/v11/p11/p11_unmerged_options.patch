+check("T7_detection_unaffected_by_gain", ax_a == 2 and ax_b == 2 and abs(d_a["ratio"] - d_b["ratio"]) < 0.05, ratio_without_with=[d_a["ratio"], d_b["ratio"]], ncc=[d_a["ncc_median_per_axis"], d_b["ncc_median_per_axis"]])
+
+# ---------------------------------------------------------------- T8
+def tile_block(n0, n1, ns, F, seed, lvl=16000.0):
+    r = np.random.default_rng(seed); an = ndimage.gaussian_filter(r.normal(size=(n0, n1, ns)).astype(np.float32), (3, 3, 1)); an = lvl * np.exp(0.25 * an / an.std())
