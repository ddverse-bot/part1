+CAP_F16 = 60000.0            # same cap as common.oct_slab_normalize / destripe.CAP_F16
+ABS_FLOOR = 1e-3             # v1's absolute floor on the per-slice median (common.oct_slab_normalize)
+
+
+def _plane(axis: int, i: int):
+    sl = [slice(None)] * 3; sl[axis] = i; return tuple(sl)
+
+
+# ----------------------------------------------------------------------------- native-level slab normalisation, any axis
+def slab_normalize(oct_vol: np.ndarray, axis: int = 0, tissue_thresh: float = 30.0, window: int = 100, out_dtype=np.float32,
+                   floor: str = "abs", gain_only: bool = False) -> tuple[np.ndarray, dict]:
+    """``common.oct_slab_normalize`` generalised.  For every plane along ``axis``: tissue median (voxels > tissue_thresh, planes with
+    > 2000 of them; others interpolated); reference = running mean of the medians over ``window`` planes (mode nearest);
+    scale = reference / median where median > floor, else 1.  ``floor``: 'abs' = 1e-3 (v1; I58's mu_s medians are only 1.9 x above
+    it), 'rel' = 1e-3 x median of the interpolated medians.  ``gain_only``: scale = 1 everywhere (the medians, reference and the
+    float16 gain are computed exactly as in v1, so the global level equals v1's).  float16 output: gain = 16384 / median(reference),
+    values clipped to [0, 60000].  With axis=0, floor='abs', gain_only=False the output is byte-identical to
+    common.oct_slab_normalize (scripts/test_octnorm.py).  -> (volume, info with per_slice_median / reference / scale lists)."""
+    axis = int(axis); assert axis in (0, 1, 2), axis; assert floor in ("abs", "rel"), floor
