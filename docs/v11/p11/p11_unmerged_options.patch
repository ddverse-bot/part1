+    n = shape[gain_axis]; g = 1 + gain_amp * np.sin(2 * np.pi * np.arange(n) / 6.0) + 0.3 * np.arange(n) / n
+    sh = [1, 1, 1]; sh[gain_axis] = n; v *= g.reshape(sh).astype(np.float32)
+    v[rng.random(shape) < zero_frac] = 0; v[:, :4] = 0                         # speckle zeros + a black band
+    return v
+
+# ---------------------------------------------------------------- T1
+for tag, level, thr in (("mu_s", 0.002, 0.00096), ("dandi", 400.0, 30.0)):
+    raw = raw_volume((70, 90, 80), level)
+    for dt in (np.float16, np.float32):
+        o1, i1 = oct_slab_normalize(raw, tissue_thresh=thr, window=20, out_dtype=dt)
+        o2, i2 = octnorm.slab_normalize(raw, axis=0, tissue_thresh=thr, window=20, out_dtype=dt, floor="abs")
+        same_info = all(np.array_equal(np.asarray(i1[k], float), np.asarray(i2[k], float), equal_nan=True) for k in ("per_slice_median", "reference", "scale")) and i1["gain"] == i2["gain"]
+        check(f"T1_axis0_identity_{tag}_{np.dtype(dt).name}", o1.dtype == o2.dtype and np.array_equal(o1, o2) and o1.tobytes() == o2.tobytes() and same_info, gain=i1["gain"])
+
+# ---------------------------------------------------------------- T2
+for ax in (1, 2):
+    raw = raw_volume((60, 70, 80), 0.002, gain_axis=ax, gain_amp=0.08)
+    o_ax, i_ax = octnorm.slab_normalize(raw, axis=ax, tissue_thresh=0.00096, window=15, out_dtype=np.float16)
