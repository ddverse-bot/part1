@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Re-derive oct150 of an existing destripe-on prep with the v1.2 vessel-level normalisation options, without the native OCT:
+
+    python scripts/renorm_prep.py --work W --out W2 [--plane-norm off|auto|0|1|2] [--plane-norm-window-mm 1.2] [--tile-flatfield off|on]
+                                  [--tile-axes auto|a,b] [--tile-period-mm auto|Pa,Pb] [--tile-band-mm 0.6,4.0] [--tile-bin-vox 2] [--tile-smooth-bins 1]
+                                  [--mask octv_mask|none] [--save-octv] [--check-identity]
+
+Why: a native I58 prep holds the 20 um float32 NIfTI (18.7 GB) plus its float16 normalised copy (9.4 GB) in RAM, which the AutoDL rules
+(one process, < ~12 GB) do not allow.  This script loads W/octv.npy (the destriped vessel level, 1.2 GB float16 on I58) into RAM, applies
+the same octreg.octnorm functions in the same order as prep_subject.py (--slab-axis auto: per-plane median normalisation along the
+sectioning axis; --tile-flatfield on: 2-D tile flat field on the en-face axes), rebuilds the 0.15 mm level exactly like prep's
+level150 (block means by k150 // kv, resample onto the stored oct150 grid), and writes W2 = symlinks to every file of W except
+oct150.npy / prep.json / octv.npy / oct150_mask_qc.png, a new oct150.npy, oct_tile_field.npy / octv_slab_factor.npy when computed, and
+prep.json with oct.renorm (options, statistics, source) and oct150_provenance + '_renorm'.  The masks (oct150_mask.npy, octv_mask.npy)
+are the source prep's, so a register.py run on W2 differs from one on W only in the oct150 intensities (the P11 probe's setting).
+The source octv already carries the native axis-0 slab correction (the P11 probe: undoing it changes nothing, N1 ~ N0), and its
+destripe field and masks were estimated on that corrected octv.  So --plane-norm auto --tile-flatfield on here is N0 + axis-2 plane
+normalisation + tile field: an APPROXIMATION of prep_subject.py --slab-axis auto --tile-flatfield on (gain-only native level, mask,
+detection and destripe on the uncorrected octv) and not the probe's N4 (= N1 + N2 + tile); it validates neither.
+
+--check-identity: no options -> the rebuilt oct150 must equal W/oct150.npy (exit 1 otherwise; the level150 replication test; run on
+the device the prep used, since the trilinear resampling is on the GPU when present).  Nothing is written into --work."""
+from __future__ import annotations
+import argparse, json, os, sys, time
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from octreg import octnorm
+from octreg.common import write_json
+
+ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+ap.add_argument("--work", type=Path, required=True); ap.add_argument("--out", type=Path, default=None)
+ap.add_argument("--plane-norm", choices=["off", "auto", "0", "1", "2"], default="off", help="per-plane median normalisation of octv along this axis (auto = the prep's destripe axis)")
+ap.add_argument("--plane-norm-window-mm", type=float, default=1.2)
+ap.add_argument("--tile-flatfield", choices=["off", "on"], default="off"); ap.add_argument("--tile-axes", type=str, default="auto", help="auto = the axes other than the prep's destripe axis | 'a,b'")
+ap.add_argument("--tile-period-mm", type=str, default="auto"); ap.add_argument("--tile-band-mm", type=str, default="0.6,4.0")
+ap.add_argument("--tile-bin-vox", type=float, default=2.0); ap.add_argument("--tile-smooth-bins", type=float, default=1.0)
+ap.add_argument("--tile-group-mm", type=float, default=2.0, help="section groups (mm along the sectioning axis) for the per-group tile diagnostics; 0 = off")
+ap.add_argument("--tile-group-mode", choices=["global", "per_group"], default="global", help="global = one tile field; per_group = one field per section group")
+ap.add_argument("--mask", choices=["octv_mask", "none"], default="octv_mask", help="voxels entering the per-plane medians and the tile maps (octv_mask = the prep's chosen mask on the octv grid)")
+ap.add_argument("--save-octv", action="store_true", help="also write the re-normalised octv.npy into --out (1.2 GB on I58)")
+ap.add_argument("--check-identity", action="store_true", help="no options: verify that the rebuilt oct150 equals W/oct150.npy (exit 1 if not)")
+ap.add_argument("--force", action="store_true", help="allow a prep whose oct150 was not derived from octv (destripe off): the rebuild then is NOT that prep's oct150")
+a = ap.parse_args(); t0 = time.time()
+def say(*x): print(*x, f"[{time.time()-t0:.0f}s]", flush=True)
+ops = a.plane_norm != "off" or a.tile_flatfield == "on"
+if a.check_identity and ops: raise SystemExit("--check-identity takes no options")
+if not a.check_identity and (a.out is None or not ops): raise SystemExit("give --out and at least one of --plane-norm / --tile-flatfield (or --check-identity)")
+if a.out is not None and a.out.resolve() == a.work.resolve(): raise SystemExit("--out must differ from --work")
+
+prep = json.load(open(a.work / "prep.json")); po = prep["oct"]
+prov = po.get("oct150_provenance", "v1")
+if not prov.startswith(("from_destriped_octv", "from_octv_nodestripe")) and not a.force:
+    raise SystemExit(f"oct150_provenance {prov!r}: oct150 of this prep was not derived from octv (destripe off) -> rebuild would differ; --force to proceed anyway")
+sp = np.asarray(po["spacing_um_zyx"], float); sp_v = np.asarray(po["vessel_level_spacing_um"], float)
+A_nat = np.load(a.work / "oct_native_affine.npy"); A150 = np.load(a.work / "oct150_affine.npy"); shape150 = tuple(int(s) for s in po["shape150"])
+target_mm = round(float(np.linalg.norm(A150[:3, :3], axis=0).mean()), 6)
+k150 = np.maximum(1, np.round(target_mm * 1000 / sp)).astype(int); kv = np.maximum(1, np.round(sp_v / sp)).astype(int)
+ds = po.get("destripe") or {}; axis_prep = int(ds["axis"]) if ds.get("applied") and ds.get("axis") is not None else None
+say(f"work {a.work}: provenance {prov}, spacing {sp.tolist()} um, vessel level {sp_v.tolist()} um, k150 {k150.tolist()}, kv {kv.tolist()}, shape150 {shape150}, destripe axis {axis_prep}")
+
+octv = np.load(a.work / "octv.npy")                                           # in RAM (the copy that is modified)
+A_v = np.load(a.work / "octv_affine.npy")
+mask = np.load(a.work / "octv_mask.npy", mmap_mode="r") if a.mask == "octv_mask" else None
+say("octv", octv.shape, octv.dtype, "mask", None if mask is None else f"{a.work / 'octv_mask.npy'}")
+R = {"source_work": str(a.work), "options": {k: (str(v) if isinstance(v, Path) else v) for k, v in vars(a).items()}, "k150": k150.tolist(), "kv": kv.tolist(), "target_mm": target_mm}
+extra = {}
+if a.plane_norm != "off":
+    ax = axis_prep if a.plane_norm == "auto" else int(a.plane_norm)
+    if ax is None: raise SystemExit("--plane-norm auto: the prep has no applied destripe axis; pass the axis explicitly")
+    win = max(1, int(round(a.plane_norm_window_mm / (float(sp_v[ax]) / 1000.0))))
+    pn = octnorm.plane_normalize_inplace(octv, axis=int(ax), window=win, mask=mask)
+    if pn.get("factor") is not None: extra["octv_slab_factor.npy"] = np.asarray(pn.pop("factor"), np.float32); pn["file"] = "octv_slab_factor.npy"
+    pn["window_mm"] = float(win * sp_v[ax] / 1000.0); R["plane_norm"] = pn; say("per-plane normalisation:", pn)
+if a.tile_flatfield == "on":
+    sect = axis_prep if a.tile_axes == "auto" else ({0, 1, 2} - {int(x) for x in a.tile_axes.split(",")}).pop()
+    if sect is None: raise SystemExit("--tile-flatfield on with --tile-axes auto: the prep has no applied destripe axis; pass --tile-axes")
+    en = octnorm.enface_axes(sect); vox_en = float(np.mean(sp_v[list(en)])) / 1000.0; bmm = [float(x) for x in a.tile_band_mm.split(",")]
+    per = None if a.tile_period_mm == "auto" else [float(p) / (float(sp_v[e]) / 1000.0) for p, e in zip(a.tile_period_mm.split(","), en)]
+    if a.tile_group_mode == "per_group" and a.tile_group_mm <= 0: raise SystemExit("--tile-group-mode per_group needs --tile-group-mm > 0")
+    gpl = int(round(a.tile_group_mm / (float(sp_v[sect]) / 1000.0))) if a.tile_group_mm > 0 else 0
+    ti = octnorm.tile_flatfield_inplace(octv, mask, sect, periods_vox=per, bin_vox=a.tile_bin_vox, smooth_bins=a.tile_smooth_bins, band_vox=(bmm[0] / vox_en, bmm[1] / vox_en),
+                                        group_planes=gpl, group_mode=a.tile_group_mode)
+    if ti.get("field_log") is not None: extra["oct_tile_field.npy"] = np.asarray(ti.pop("field_log"), np.float32); ti["file"] = "oct_tile_field.npy"
+    _fg = octnorm.pop_group_fields(ti)
+    if _fg is not None: extra["oct_tile_field_groups.npy"] = _fg
+    if ti.get("groups") is not None: ti["groups"]["group_mm"] = float(gpl * sp_v[sect] / 1000.0)
+    if ti.get("periods_vox"): ti["periods_mm"] = [float(p * sp_v[e] / 1000.0) for p, e in zip(ti["periods_vox"], en)]
+    R["tile_flatfield"] = ti; say("tile flat field:", {k: v for k, v in ti.items() if k not in ("estimate", "groups")}); say("period estimation:", ti.get("estimate"))
+    say("tile section groups:", (ti.get("groups") or {}).get("summary"))
+del mask
+o150 = octnorm.level150_from_octv(octv, A_nat, sp, kv, k150, A150, shape150).astype(np.float32)
+src = np.load(a.work / "oct150.npy", mmap_mode="r"); m150 = np.load(a.work / "oct150_mask.npy", mmap_mode="r").astype(bool)
+d = np.abs(o150.astype(np.float64) - np.asarray(src, np.float64)); lr = np.log(np.maximum(o150[m150], 1e-6) / np.maximum(np.asarray(src)[m150], 1e-6))
+R["vs_source_oct150"] = {"array_equal": bool(np.array_equal(o150, np.asarray(src))), "max_abs": float(d.max()), "zero_pattern_equal": bool(np.array_equal(o150 > 0, np.asarray(src) > 0)),
+                         "std_log_ratio_in_mask": float(lr.std()), "median_log_ratio_in_mask": float(np.median(lr))}
+say("rebuilt oct150 vs the source oct150:", R["vs_source_oct150"])
+if a.check_identity:
+    ok = R["vs_source_oct150"]["array_equal"]; say("IDENTITY", "PASS" if ok else "FAIL"); sys.exit(0 if ok else 1)
+
+a.out.mkdir(parents=True, exist_ok=True)
+skip = {"oct150.npy", "prep.json", "octv.npy", "oct150_mask_qc.png"} | set(extra)
+for f in sorted(a.work.iterdir()):
+    if f.name in skip or f.is_dir(): continue
+    dst = a.out / f.name
+    if not dst.exists() and not dst.is_symlink(): os.symlink(f.resolve(), dst)
+np.save(a.out / "oct150.npy", o150)
+for name, arr in extra.items(): np.save(a.out / name, arr)
+if a.save_octv: np.save(a.out / "octv.npy", octv)
+R["octv_saved"] = bool(a.save_octv); R["seconds"] = time.time() - t0
+prep2 = json.loads(json.dumps(prep)); prep2["oct"]["oct150_provenance"] = prov + "_renorm"; prep2["oct"]["renorm"] = R
+write_json(prep2, a.out / "prep.json"); say("wrote", a.out)
