+        del x, valid
+    out = {"applied": True, "sect_axis": sect_axis, "enface_axes": [e0, e1], "periods_vox": [float(P0), float(P1)], "periods_source": "given" if periods_vox is not None else "estimated",
+           "estimate": est, "field": finfo, "plausibility": plaus, "field_log": np.round(F2, 5).tolist(), "tile_min_max": [float(tile.min()), float(tile.max())], "band_vox": list(band_vox)}
+    if residual:
+        if bounds is not None:
+            Lg2, Ng2 = enface_log_maps_grouped(vol, mask, sect_axis, bounds, chunk); _, _, _, after = tile_field_2d(Lg2.sum(0), Ng2.sum(0), P0, P1, bin_vox, smooth_bins)
+            for rec in groups["per_group"]:
+                if "field_log_std_before" not in rec: continue
+                _, _, _, fa = tile_field_2d(Lg2[rec["group"]], Ng2[rec["group"]], P0, P1, bin_vox, smooth_bins)
+                rec["residual_log_std_after"] = fa.get("log_std"); rec["after_over_before"] = float(fa["log_std"] / rec["field_log_std_before"]) if fa.get("log_std") is not None and rec["field_log_std_before"] > 0 else None
+            del Lg2, Ng2
+        else:
+            L2, N2 = enface_log_maps(vol, mask, sect_axis, chunk); _, _, _, after = tile_field_2d(L2, N2, P0, P1, bin_vox, smooth_bins)
+        out["residual_field"] = after
+    if groups is not None:
+        pg = [r for r in groups["per_group"] if "field_log_std_before" in r]; ratios = [r["after_over_before"] for r in pg if r.get("after_over_before") is not None]
+        corrs = [r["fold_corr_with_global"] for r in pg if r.get("fold_corr_with_global") is not None]
+        groups["summary"] = {"n_groups": len(groups["per_group"]), "n_groups_scored": len(pg), "n_groups_corr_below_0.3": int(sum(c < 0.3 for c in corrs)),
+                             "min_fold_corr_with_global": min(corrs) if corrs else None, "n_groups_after_gt_before": int(sum(q > 1.0 for q in ratios)) if ratios else None,
+                             "max_after_over_before": max(ratios) if ratios else None}
+        out["groups"] = groups
+    out["seconds"] = time.time() - t0
+    return out
+
+
+def pop_group_fields(info: dict, file_name: str = "oct_tile_field_groups.npy"):
+    """Take groups.field_log (per_group mode) out of a tile_flatfield_inplace info -> [G, nb0, nb1] float32 array (nan = the group used the
+    global field) or None; records ``file_name`` in info.groups.field_log_file (the caller saves the array under that name)."""
+    g = info.get("groups") or {}
+    fl = g.pop("field_log", None)
+    if fl is None: return None
+    nb = (info.get("field") or {}).get("nb") or [1, 1]
+    g["field_log_file"] = file_name
+    return np.stack([np.asarray(f, np.float32) if f is not None else np.full(tuple(nb), np.nan, np.float32) for f in fl])
+
+
+# ----------------------------------------------------------------------------- 0.15 mm level (prep_subject.py level150, destripe-on path)
+def level150_from_octv(vol_v: np.ndarray, A_nat: np.ndarray, sp_um, kv, k150, A150: np.ndarray, shape150):
+    """oct150 from a vessel-level volume exactly as prep_subject.py's level150(): block means by k150 // kv, then trilinear resampling
+    from pooled_affine(A_nat, k150) onto the stored 0.15 mm grid (A150, shape150).  Uses octreg.common (GPU when available)."""
+    from .common import pool_mean_np, pooled_affine, resample_to_grid, to_t
+    kv = np.asarray(kv, int); k150 = np.asarray(k150, int)
+    A_p = pooled_affine(np.asarray(A_nat), k150)
+    p150 = pool_mean_np(vol_v, k150 // kv)
+    return resample_to_grid(to_t(p150)[None], to_t(A_p), to_t(np.asarray(A150)), tuple(int(s) for s in shape150)).cpu().numpy()[0]
