+    return {"applied": True, "axis": axis, "window": window, "min_count": min_count, "n_planes": int(len(med)), "n_valid": int(good.sum()),
+            "fac_min_max": [float(fac[good].min()), float(fac[good].max())], "std_log_fac": float(lf.std()), "dominant_period_planes": per,
+            "median_min_max": [float(np.nanmin(med)), float(np.nanmax(med))], "factor": fac.tolist(), "seconds": time.time() - t0}
+
+
+# ----------------------------------------------------------------------------- tile (mosaic) flat field on the en-face axes
+def enface_axes(sect_axis: int) -> tuple[int, int]:
+    return tuple(a for a in range(3) if a != int(sect_axis))
+
+
+def enface_log_maps(vol: np.ndarray, mask: np.ndarray | None, sect_axis: int, chunk: int = 64):
+    """Sum of log(vol) and voxel count over the sectioning axis on the valid voxels (vol > 0, & mask) -> (L, N) on the en-face plane
+    (en-face axes in increasing order).  Chunked along array axis 0 (float32 per chunk, as the P11 probe)."""
+    sect_axis = int(sect_axis); e0, e1 = enface_axes(sect_axis)
+    L = np.zeros((vol.shape[e0], vol.shape[e1])); N = np.zeros((vol.shape[e0], vol.shape[e1]))
+    for z0 in range(0, vol.shape[0], chunk):
+        z1 = min(vol.shape[0], z0 + chunk); x = np.asarray(vol[z0:z1]).astype(np.float32)
+        m = (x > 0) if mask is None else (np.asarray(mask[z0:z1]).astype(bool) & (x > 0))
+        lx = np.where(m, np.log(np.maximum(x, 1e-6)), 0)
+        if sect_axis == 0: L += lx.sum(0); N += m.sum(0)
+        elif sect_axis == 1: L[z0:z1] += lx.sum(1); N[z0:z1] += m.sum(1)
+        else: L[z0:z1] += lx.sum(2); N[z0:z1] += m.sum(2)
+        del x, m, lx
+    return L, N
+
+
+def group_bounds(n: int, group_planes: int) -> list[tuple[int, int]]:
+    """Contiguous groups of ``group_planes`` planes along a length-n axis; a last group shorter than half a group joins the previous one."""
+    g = max(1, int(group_planes)); b = [(s, min(n, s + g)) for s in range(0, n, g)]
+    if len(b) > 1 and b[-1][1] - b[-1][0] < g / 2.0: b[-2] = (b[-2][0], b[-1][1]); b.pop()
+    return b
+
+
+def enface_log_maps_grouped(vol: np.ndarray, mask: np.ndarray | None, sect_axis: int, bounds, chunk: int = 64):
+    """enface_log_maps per group of sectioning-axis planes -> (L [G, n_e0, n_e1], N [G, n_e0, n_e1]); summed over groups = enface_log_maps
+    up to float rounding."""
+    sect_axis = int(sect_axis); e0, e1 = enface_axes(sect_axis); G = len(bounds)
+    L = np.zeros((G, vol.shape[e0], vol.shape[e1])); N = np.zeros((G, vol.shape[e0], vol.shape[e1]))
+    for z0 in range(0, vol.shape[0], chunk):
+        z1 = min(vol.shape[0], z0 + chunk); x = np.asarray(vol[z0:z1]).astype(np.float32)
+        m = (x > 0) if mask is None else (np.asarray(mask[z0:z1]).astype(bool) & (x > 0))
+        lx = np.where(m, np.log(np.maximum(x, 1e-6)), 0)
+        for g, (g0, g1) in enumerate(bounds):
+            if sect_axis == 0:
+                s0, s1 = max(g0, z0), min(g1, z1)
+                if s0 < s1: L[g] += lx[s0 - z0:s1 - z0].sum(0); N[g] += m[s0 - z0:s1 - z0].sum(0)
+            elif sect_axis == 1: L[g, z0:z1] += lx[:, g0:g1].sum(1); N[g, z0:z1] += m[:, g0:g1].sum(1)
+            else: L[g, z0:z1] += lx[:, :, g0:g1].sum(2); N[g, z0:z1] += m[:, :, g0:g1].sum(2)
+        del x, m, lx
+    return L, N
+
+
+def _valid_extent(N: np.ndarray, ax: int) -> int:
+    """Number of en-face lines along map axis ``ax`` between the first and the last line with >= 2 % of the maximum count (as estimate_tile_period)."""
+    w = N.sum(1 - int(ax))
+    if w.max() <= 0: return 0
+    ii = np.where(w > 0.02 * w.max())[0]; return int(ii.max() - ii.min() + 1)
+
+
+def _box_detrend(prof, w, win):
+    num = ndimage.uniform_filter1d(np.where(w > 0, prof * w, 0.0), int(win), mode="constant"); den = ndimage.uniform_filter1d(w.astype(float), int(win), mode="constant")
+    return prof - num / np.maximum(den, 1e-12), den / max(float(w.max()), 1e-12)
+
+
+def _fold_r2(prof, w, P, nb=24):
+    """Weighted fold of a profile at period P (nb phase bins) -> (R2 = folded variance / total variance, zero-mean fold, bin weights)."""
+    ph = np.floor(((np.arange(len(prof)) / P) % 1.0) * nb).astype(int) % nb; ok = np.isfinite(prof) & (w > 0)
+    if ok.sum() < 2 * nb: return 0.0, np.zeros(nb), np.zeros(nb)
+    sw = np.bincount(ph[ok], w[ok], nb); fm = np.bincount(ph[ok], w[ok] * prof[ok], nb) / np.maximum(sw, 1e-12); mu = (w[ok] * prof[ok]).sum() / w[ok].sum()
+    vt = (w[ok] * (prof[ok] - mu) ** 2).sum() / w[ok].sum(); vf = (sw * (fm - mu) ** 2).sum() / sw.sum()
+    return float(vf / max(vt, 1e-30)), fm - (sw * fm).sum() / sw.sum(), sw
+
+
+def _fft_peaks(p, pmin, pmax, pad=1 << 15, top=3):
+    p = np.asarray(p, float); p = p - p.mean(); P = np.abs(np.fft.rfft(p * np.hanning(len(p)), pad)) ** 2; f = np.fft.rfftfreq(pad)
+    per = 1.0 / np.maximum(f, 1e-12); band = (per >= pmin) & (per <= pmax)
+    idx = np.where(band[1:-1] & (P[1:-1] > P[:-2]) & (P[1:-1] >= P[2:]))[0] + 1
+    if idx.size == 0: return []
+    idx = idx[np.argsort(-P[idx])][:top]; med = float(np.median(P[band])) if band.any() else 0.0
+    return [{"period_vox": float(per[i]), "over_band_median": float(P[i] / med) if med > 0 else None} for i in idx]
+
+
+def _fft_top_period(p, pmin, pmax):
+    pk = _fft_peaks(p, pmin, pmax, top=1); return pk[0]["period_vox"] if pk else None
+
+
+def estimate_tile_period(L: np.ndarray, N: np.ndarray, ax: int, band_vox=(15.0, 100.0), rel: float = 0.1, step: float = 0.02, nb: int = 24,
+                         harmonic_ratio: float = 1.2, n_fft: int = 3) -> tuple[float | None, dict]:
+    """Tile fundamental along en-face map axis ``ax`` (0/1 of the (L, N) maps).  Profile = mean log per line (lines with >= 2 % of the
+    maximum count), detrended by a count-normalised boxcar of the band's longest period; candidates = the ``n_fft`` strongest FFT
+    peaks in ``band_vox`` and their doubles inside the band; each candidate refined by the fold-R2 maximum over +-rel at ``step`` and
+    scored by its contrast = R2(P) - mean R2 at the off-period controls 0.87 P and 1.13 P (a smooth anatomy profile folds well at any
+    long period, a tile only at its own); the best contrast wins, except that a winner ~k x a shorter candidate (within 5 %) is replaced by the shorter one
+    when k >= 3, and for k = 2 unless its contrast is >= harmonic_ratio x the shorter one's (an alternating mosaic has its
+    fundamental at twice the tile step: I58 axis 0 R2 0.32 at 70.4 vs 0.22 at 35.4, controls 0.02-0.07).  -> (period in map voxels or None, info)."""
+    oth = 1 - int(ax); w = N.sum(oth); S = L.sum(oth)
+    if w.max() <= 0: return None, {"reason": "empty"}
+    okp = w > 0.02 * w.max(); ii = np.where(okp)[0]; a, b = int(ii.min()), int(ii.max()) + 1
+    lm = np.where(w > 0, S / np.maximum(w, 1), 0.0); wv = np.where(okp, w, 0.0)
+    win = int(round(band_vox[1])); d, cover = _box_detrend(lm, wv, win); wd = np.where(okp & (cover > 0.5), w, 0.0)
+    pk = _fft_peaks(d[a:b], band_vox[0], band_vox[1], top=n_fft)
+    cands = sorted({round(q["period_vox"], 2) for q in pk} | {round(2 * q["period_vox"], 2) for q in pk if 2 * q["period_vox"] <= band_vox[1]})
+    scans = []
+    for c in cands:
+        Ps = np.arange(c * (1 - rel), c * (1 + rel), step); r2 = np.array([_fold_r2(d, wd, P, nb)[0] for P in Ps]); j = int(np.argmax(r2))
+        c087 = _fold_r2(d, wd, Ps[j] * 0.87, nb)[0]; c113 = _fold_r2(d, wd, Ps[j] * 1.13, nb)[0]
+        scans.append({"candidate": float(c), "P": float(Ps[j]), "R2": float(r2[j]), "R2_control_0.87P": c087, "R2_control_1.13P": c113, "contrast": float(r2[j] - 0.5 * (c087 + c113))})
+    if not scans: return None, {"reason": "no_fft_peak", "fft_peaks": pk, "detrend_vox": win}
+    win_s = max(scans, key=lambda s: s["contrast"])
+    for s in sorted(scans, key=lambda s: s["P"]):
+        k = win_s["P"] / s["P"]
+        if s is win_s or s["contrast"] <= 0 or k < 1.9 or abs(k - round(k)) > 0.05 * round(k): continue
+        if round(k) >= 3 or win_s["contrast"] < harmonic_ratio * s["contrast"]:     # a mosaic alternates at most with period 2 x step
+            win_s = s; break
+    if win_s["contrast"] <= 0: return None, {"reason": "no_period_with_positive_contrast", "fft_peaks": pk, "detrend_vox": win, "scans": scans}
+    return float(win_s["P"]), {"fft_peaks": pk, "detrend_vox": win, "scans": scans, "chosen": win_s, "valid_range": [a, b], "harmonic_ratio": harmonic_ratio}
+
+
+def tile_field_2d(L: np.ndarray, N: np.ndarray, P0: float, P1: float, bin_vox: float = 2.0, smooth_bins: float = 1.0):
+    """2-D folded tile field (P11 norm_tiles.field2d): mean-log map detrended by a count-normalised boxcar of one period per axis (lines
+    with box cover <= 0.5 get no weight), folded at (P0, P1) with round(P / bin_vox) bins per axis (count-weighted), circular Gaussian
+    smoothing of ``smooth_bins``, weighted mean removed.  -> (F2 [nb0, nb1] log field, q0 [n0] bin index per line, q1 [n1], info)."""
+    nb0 = max(2, int(round(P0 / bin_vox))); nb1 = max(2, int(round(P1 / bin_vox))); k0, k1 = int(round(P0)), int(round(P1))
+    lm = np.where(N > 0, L / np.maximum(N, 1), 0.0)
+    num = ndimage.uniform_filter(np.where(N > 0, L, 0.0), (k0, k1), mode="constant"); den = ndimage.uniform_filter(N.astype(float), (k0, k1), mode="constant")
+    cover = ndimage.uniform_filter((N > 0).astype(float), (k0, k1), mode="constant")
