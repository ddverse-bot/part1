+#!/bin/bash
+# I58-only test chain for the P11 implementation (octnorm prep options, renorm_prep.py, qc_fine body block, exclusion-mask builder).
+# Strictly serial: one python process at a time (no python parent while a python child runs), OMP_NUM_THREADS=4, GPU 0 only where a step
+# says gpu; never any DANDI subject.  Every output goes under $IMPL (= /root/autodl-tmp/v11_dev/P11/impl); work/, runs, logs/ and octreg/
+# of the live tree are read-only inputs, and the only rm -rf is on directories under $IMPL (safe_rm refuses anything else).
+# A failed step is logged and the chain continues (no set -e), except that T5 falls back to the probe's explicit tile periods and T6/T7
+# skip a re-levelled prep whose renorm check did not pass (the summary then reports it as NO-RUN).
+# Run it detached and registered with the memory watchdog (run plan in the implementation record); poll $LOG/chain.log.
+#   CODE=/root/autodl-tmp/v11_dev/P11/impl/octreg bash $CODE/scripts/run_p11_impl_i58.sh [T0 T1 ...]   (default: T0..T8; OPT_* only on request)
+set -u
+BASE=/root/autodl-tmp/oct-mri-registration; cd $BASE
+source /root/miniconda3/etc/profile.d/conda.sh; conda activate octmri
+export OMP_NUM_THREADS=4
+IMPL=/root/autodl-tmp/v11_dev/P11/impl                                                   # the ONLY place this chain writes to
+C=${CODE:-$IMPL/octreg}; S=$C/scripts                                                    # the tree under test (uncommitted P11 implementation)
+LIVE=$BASE/octreg                                                                        # the live tree (= HEAD), reference for identity tests
+# read-only inputs
+W=work/v11/xiangrui_I58bs; R5=work/runs/v11/xiangrui_I58bs; P_R5=$R5/T_oct2mri_structural.npy; RUNS_IN=work/runs/v11
+EX=/root/autodl-tmp/v11_dev/P11/exclude; NORM=/root/autodl-tmp/v11_dev/P11/norm
+# outputs
+LOG=$IMPL/logs; MASKS=$IMPL/masks; T=$IMPL/tests; PREPS=$IMPL/preps; RUNS=$IMPL/runs
+WT=$PREPS/xiangrui_I58bs_p11tile; WV=$PREPS/xiangrui_I58bs_p11pn2tile
+PERIODS_MM=2.8176,2.7888                                                                 # P11 probe:norm fold-scan periods 70.44 / 69.72 voxels at 40 um
+mkdir -p $LOG $MASKS $T $PREPS $RUNS; CHAIN=$LOG/chain.log
+step() {  # step NAME cmd... -> $LOG/NAME.log; returns the command's exit code, never aborts the chain
+  local name=$1; shift
+  echo "[$name start] $(date '+%F %T')  $*" | tee -a $CHAIN
+  "$@" > $LOG/$name.log 2>&1; local rc=$?
+  echo "[$name done rc=$rc] $(date '+%F %T')" | tee -a $CHAIN
+  [ $rc -ne 0 ] && tail -5 $LOG/$name.log | tee -a $CHAIN
+  return $rc
+}
+safe_rm() {  # safe_rm DIR: rm -rf only inside $IMPL
+  case "$(realpath -m "$1")" in
+    $IMPL/?*) rm -rf "$1" ;;
+    *) echo "[safe_rm] REFUSED to remove $1 (outside $IMPL)" | tee -a $CHAIN; return 1 ;;
+  esac
+}
+cpu() { env CUDA_VISIBLE_DEVICES= "$@"; }
+gpu() { env CUDA_VISIBLE_DEVICES=0 "$@"; }
+variant_ok() {  # variant_ok DIR: the renorm check of that re-levelled prep passed (renorm_check.json written by p11_impl_check.py renorm-check)
+  [ -f "$1/renorm_check.json" ] && grep -q '^ "pass": true' "$1/renorm_check.json"          # top-level key (json.dumps indent=1)
+}
+QC_MASKS="--oct-exclude-mask $MASKS/oct_folia_excl.npy --mri-exclude-mask $MASKS/mri_cereb_excl_d1.0.npy"
+renorm_variant() {  # renorm_variant NAME OUTDIR extra-flags...: auto tile periods first; explicit probe periods if the check fails
