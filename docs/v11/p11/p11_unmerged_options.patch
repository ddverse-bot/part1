+++ b/scripts/make_exclusion_masks_i58.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Rebuild the I58 non-correspondence (exclusion) masks of the P11 probe:exclude from their sources, so they are not orphan probe files:
+
+    python scripts/make_exclusion_masks_i58.py --work work/v11/xiangrui_I58bs --piece-labels work/probe_xr/pieces/piece_labels_tex2.npy --out DIR
+                                               [--pose work/runs/v11/xiangrui_I58bs/T_oct2mri_structural.npy] [--ref-dir DIR] [--figure]
+
+MRI grid (mri.npy, I58 343 x 489 x 495 @ 0.08 mm):
+  mri_cereb_excl_d{0.5,1.0}.npy  P7 piece label 2 (the chosen texture + brightness cut, piece_labels_tex2.npy: 1 body 9.35 cm3, 2 cerebellum 4.15 cm3)
+                                 dilated by 0.5 / 1.0 mm (EDT <= r)
+  mri_fov_rind_1.0mm.npy         voxels within ceil(1.0 mm / voxel) voxels of any array face (the crop field-of-view rind)
+OCT grid (oct150.npy, I58 194 x 267 x 212 @ 0.15 mm):
+  oct_folia_excl.npy             oct150_mask & the deep folded-piece boxes (index space): [z 90-193, y >= max(140, 190 - 1.25 (z - 90)) for z < 130
+                                 else 140, x < 125] | [z 60-89, y >= 195, x 80-139]; chosen from the probe's deep_{z,y,x}.png and P10 (torn folia at
+                                 z 125-175, y 150-240, x 30-120).  A geometric region, not a segmentation (mask erosion never separates the pieces).
+  oct_shell_1.0mm.npy            oct150_mask & EDT(mask, box faces = background) < 1.0 mm
+masks.json: the volumes of the probe's masks.json, grids.{oct150,mri} = shape and affine of the grids the masks were built on (qc_fine.py
+checks them against its --work), and, with --pose, the MRI body / cerebellum labels nearest-resampled onto oct150 through that pose
+(overlap volumes + oct_exclusion_overlay.png with --figure).  --ref-dir: every written mask must exist there under the same name and be
+np.array_equal to it; a missing or different reference exits 1 (e.g. /root/autodl-tmp/v11_dev/P11/exclude/masks).
+
+P11 probe:exclude, as re-read in the 2026-09-14 review: adding these exclusions to register.py did not help I58.  The search winners became
+a mirrored, 5 % shrunk pose (V1, V2) or a FOV-degenerate pose (V3, V4), and refinement from P_R5 moved 6.5-8.2 mm / 15-19 deg.  Under the
+C3 boundary rule the rigid exclusion solutions are WORSE than P_R5 and the V1 affine solution scored without exclusions is EQUIVALENT
+(C1 was not testable: V0 already had 11/12 small restarts).  The mirrored pose is not a consequence of removing the cerebellum:
+register.py's own 0.15 mm NCC already scores the mirrored V1 winner above P_R5 without any exclusion (0.1358 vs 0.1241); what kept it out
+of R5 was the adaptive overlap gate (0.590, 880 orientations admitted vs 16000 at V1's 0.425).  That is a register.py weakness, not an
+exclusion effect.  Use the masks only for the report-only body block of scripts/qc_fine.py (--oct-exclude-mask oct_folia_excl.npy
+--mri-exclude-mask mri_cereb_excl_d1.0.npy), within one pose set (body numbers depend on the pose set: P_R5 body fwd 3.24 vs 2.40 mm)."""
+from __future__ import annotations
+import argparse, json, sys, time
+from pathlib import Path
+import numpy as np
+from scipy import ndimage
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+FOLIA_BOXES = [((90, 194), (140, 267), (0, 125)),      # main cluster of torn lobules, bottom of the block
+               ((60, 90), (195, 267), (80, 140))]      # the few upper lobules
+SLOPE = {"z_range": (90, 130), "y_top": 140, "y_at_z90": 190, "dy_dz": -1.25, "x_range": (0, 125)}
+R_CEREB = (0.5, 1.0); R_SHELL = (1.0,); R_FOV = 1.0
+I58_SHAPES = {"oct150": (194, 267, 212), "mri": (343, 489, 495)}
+
+ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+ap.add_argument("--work", type=Path, required=True, help="the I58 prep dir (mri_tissue.npy, mri_affine.npy, oct150.npy, oct150_mask.npy, oct150_affine.npy)")
+ap.add_argument("--piece-labels", type=Path, required=True, help="P7 piece labels on the MRI grid (1 body, 2 cerebellum)")
+ap.add_argument("--out", type=Path, required=True); ap.add_argument("--pose", type=Path, default=None, help="optional OCT world -> MRI world pose for the labels-via-pose numbers / figure")
+ap.add_argument("--ref-dir", type=Path, default=None, help="compare every mask with the same-named .npy in this dir (exit 1 on any difference)")
+ap.add_argument("--figure", action="store_true", help="oct_exclusion_overlay.png (needs --pose for the MRI label contours)")
+ap.add_argument("--force", action="store_true", help="allow grids that are not the I58 grids (the folia boxes are I58 index boxes)")
+a = ap.parse_args(); a.out.mkdir(parents=True, exist_ok=True); t0 = time.time()
+def say(*x): print(*x, f"[{time.time()-t0:.0f}s]", flush=True)
+
+mask = np.load(a.work / "oct150_mask.npy").astype(bool); A_oct = np.load(a.work / "oct150_affine.npy"); A_mri = np.load(a.work / "mri_affine.npy")
+tis = np.load(a.work / "mri_tissue.npy").astype(bool); L = np.load(a.piece_labels)
+if not a.force and (tuple(mask.shape) != I58_SHAPES["oct150"] or tuple(tis.shape) != I58_SHAPES["mri"]):
+    raise SystemExit(f"grids {mask.shape} / {tis.shape} are not the I58 grids {I58_SHAPES}: the folia boxes are I58 index boxes (--force to build anyway)")
+if L.shape != tis.shape: raise SystemExit(f"piece labels {L.shape} != MRI grid {tis.shape}")
+vox_o = round(float(np.linalg.norm(A_oct[:3, :3], axis=0).mean()), 6); vox_m = round(float(np.linalg.norm(A_mri[:3, :3], axis=0).mean()), 6)
+V_O = vox_o ** 3 / 1000; V_M = vox_m ** 3 / 1000
+info = {"folia_boxes_zyx": FOLIA_BOXES, "folia_main_box_y0_of_z": "max(140, 190 - 1.25 (z - 90)) for z in [90,130); 140 for z >= 130", "cereb_dilation_mm": list(R_CEREB), "shell_mm": list(R_SHELL),
+        "fov_rind_mm": R_FOV, "sources": {"work": str(a.work), "piece_labels": str(a.piece_labels), "pose": None if a.pose is None else str(a.pose)}, "voxel_mm": {"oct150": vox_o, "mri": vox_m}}
+written = {}
+info["grids"] = {"oct150": {"shape": list(mask.shape), "affine": A_oct.tolist()}, "mri": {"shape": list(tis.shape), "affine": A_mri.tolist()}}
+
+# ---------------- MRI
+cer = L == 2; body = L == 1
+info["mri"] = {"cereb_cm3": float(cer.sum() * V_M), "body_cm3": float(body.sum() * V_M), "raw_tissue_cm3": float(tis.sum() * V_M)}
+d = ndimage.distance_transform_edt(~cer, sampling=(vox_m,) * 3).astype(np.float32)
+for r in R_CEREB:
+    m = d <= r; name = f"mri_cereb_excl_d{r}.npy"; np.save(a.out / name, m); written[name] = m.shape
+    bb = np.argwhere(m)
+    info["mri"][f"cereb_excl_d{r}"] = {"cm3": float(m.sum() * V_M), "raw_tissue_removed_cm3": float((m & tis).sum() * V_M), "body_label_removed_cm3": float((m & body).sum() * V_M),
