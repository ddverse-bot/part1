+#!/usr/bin/env python3
+"""Synthetic CPU tests of octreg.octnorm (no data needed; ~1 min):
+
+    python scripts/test_octnorm.py [--out DIR]
+
+T1 slab_normalize(axis=0, floor abs) is byte-identical to the frozen common.oct_slab_normalize (float16 and float32 outputs; mu_s-like and
+   DANDI-like intensities).
+T2 slab_normalize along axis 1 / 2 equals the axis-0 result on the transposed volume (byte-identical) and flattens a per-plane gain.
+T3 gain_only: scale 1 everywhere, the float16 gain equals v1's, output = clip(raw x gain) in float16.
+T4 floor: 'rel' equals 'abs' when no median is near 1e-3; with medians below 1e-3 'abs' leaves them uncorrected and 'rel' corrects them.
+T5 plane_normalize_inplace removes a per-plane gain along the sectioning axis (detrended profile std reduced >= 5 x), zeros stay 0,
+   valid voxels in [1, 60000]; exact medians.
+T6 tile_flatfield_inplace on a volume with a known non-separable alternating 2-D tile field: estimated periods within 1 %, field
+   correlation >= 0.9, residual field log std <= 0.3 x the field's, zeros unchanged; sectioning axis 0 gives the same field as axis 2 on
+   the transposed volume (to float16 rounding of a different summation order, <= 1e-3 relative); given periods reproduce the estimated-period result when equal; with the axis-0 tile marginal removed (a per-slice
+   normalisation along that en-face axis) axis 0 borrows axis 1's period.
+T7 destripe.detect_stripe_axis finds the same axis with and without a +-5 % per-slice gain along another axis (the 'auto' ordering).
+T8 plausibility guard (review 2026-09-14): estimated periods on an en-face extent with < 5 tile cycles, or a fitted field with log std > 0.05,
+   are rejected (applied False, volume unchanged); the same periods GIVEN are applied with the failure in plausibility.warnings.
+T9 section groups: a tile pattern shifted by one tile step (sign of the fundamental flipped) in 2 of 8 section groups: the global field
+   makes those groups' tile amplitude larger (after / before > 1, reported in groups.summary), 'per_group' removes it in every group
+   (after / before < 0.6) and leaves a lower true-field residual than 'global' in the shifted groups; group_planes > 0 with 'global'
+   gives the same field as group_planes 0 (to float rounding)."""
+from __future__ import annotations
+import argparse, json, sys, time
+from pathlib import Path
+import numpy as np
+from scipy import ndimage
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from octreg import octnorm
+from octreg.common import oct_slab_normalize
+from octreg.destripe import detect_stripe_axis, profile_residual
+
+ap = argparse.ArgumentParser(); ap.add_argument("--out", type=Path, default=None); a = ap.parse_args(); t0 = time.time()
+R = {}; FAIL = []
+def check(name, ok, **kv):
+    R[name] = {"pass": bool(ok), **{k: (v.tolist() if isinstance(v, np.ndarray) else v) for k, v in kv.items()}}
+    print(f"[{'PASS' if ok else 'FAIL'}] {name} {kv}  [{time.time()-t0:.0f}s]", flush=True)
+    if not ok: FAIL.append(name)
+rng = np.random.default_rng(7)
+
+def raw_volume(shape, level, gain_axis=0, gain_amp=0.06, zero_frac=0.1):
+    base = ndimage.gaussian_filter(rng.normal(size=shape).astype(np.float32), 2.0); base = (base - base.mean()) / (base.std() + 1e-9)
