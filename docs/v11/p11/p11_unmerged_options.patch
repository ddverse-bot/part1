+    lab = (q0[:, None] * nb1 + q1[None, :]).ravel()
+    sw = np.bincount(lab, W.ravel(), nb0 * nb1).reshape(nb0, nb1)
+    if sw.sum() <= 0:
+        return np.zeros((nb0, nb1)), q0, q1, {"nb": [nb0, nb1], "P": [float(P0), float(P1)], "reason": "no_weight"}
+    F2 = np.bincount(lab, (W * r).ravel(), nb0 * nb1).reshape(nb0, nb1) / np.maximum(sw, 1e-9)
+    if smooth_bins: F2 = ndimage.gaussian_filter(F2, smooth_bins, mode="wrap")
+    F2 -= (sw * F2).sum() / sw.sum()
+    a0 = (sw * F2).sum(1) / np.maximum(sw.sum(1), 1e-9); a1 = np.zeros(nb1)
+    for _ in range(10): a1 = (sw * (F2 - a0[:, None])).sum(0) / np.maximum(sw.sum(0), 1e-9); a0 = (sw * (F2 - a1[None, :])).sum(1) / np.maximum(sw.sum(1), 1e-9)
+    sep = a0[:, None] + a1[None, :]; v2 = (sw * F2 ** 2).sum() / sw.sum(); vs = (sw * sep ** 2).sum() / sw.sum()
+    resvar = (W * r ** 2).sum() / max(W.sum(), 1e-9)
+    info = {"nb": [nb0, nb1], "P": [float(P0), float(P1)], "bin_vox": float(bin_vox), "smooth_bins": float(smooth_bins), "log_std": float(np.sqrt(v2)), "log_p2p": float(F2.max() - F2.min()),
+            "separable_R2": float(vs / v2) if v2 > 0 else None, "field_var_over_residual_var": float(v2 / resvar) if resvar > 0 else None,
+            "marginal_p2p_axis0": float(a0.max() - a0.min()), "marginal_p2p_axis1": float(a1.max() - a1.min())}
+    return F2, q0, q1, info
+
+
+def tile_flatfield_inplace(vol: np.ndarray, mask: np.ndarray | None, sect_axis: int, periods_vox=None, bin_vox: float = 2.0, smooth_bins: float = 1.0,
