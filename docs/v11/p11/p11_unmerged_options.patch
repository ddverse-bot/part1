+#!/usr/bin/env python3
+"""Synthetic CPU test of scripts/qc_fine.py's P11 options (~2 min, no data needed):
+
+    python scripts/test_qc_options.py --out DIR [--ref-tree PATH_TO_A_CHECKOUT_OF_THE_PREVIOUS_COMMIT] [--stage all|gen|check]
+
+--stage all (default) generates the data, runs every qc_fine child from this process and checks.  On the AutoDL server (one python
+process at a time) run it in three stages: 'gen' (data, exclusion masks and DIR/children.sh), 'bash DIR/children.sh' (the qc_fine
+children one after another, each writing DIR/NAME.log and DIR/NAME.rc), then 'check' (reads the outputs; no child is started).
+
+Builds a 0.15 mm OCT block (60 x 70 x 56) and a 0.08 mm MRI whose tissue ellipsoid and texture correspond through a known rigid pose
+(the run's T_oct2mri.npy; T_oct2mri_prefine.npy = a 0.4 mm / 3 deg perturbation), then checks:
+
+Q0 (with --ref-tree) defaults: qc_fine.json of this tree equals the reference tree's (every key except 'seconds').
+Q1 --pose alt=T: the extra pose is scored in 'boundary' and 'pose_diffs'; the final pose's rim medians stay within 0.05 mm of the default run.
+Q2 all-False exclusion masks: 'boundary_body' equals 'boundary' for every pose (forward / reverse overall, rim and deep-end statistics) and
+   'mi_landscape_body' equals 'mi_landscape' (values at T and every landscape value).
+Q3 an OCT exclusion (z+ half of the mask) and an MRI exclusion (the MRI-world image of that half dilated 1.6 mm): fewer body boundary points,
+   no forward deep-end points left, forward points dropped by the union rule, union exclusion counts do not decrease when a pose is added, report_only flag and union pose list recorded.
+Q4 a mask of the wrong shape exits non-zero.
+Q5 an exclusion mask with label values (uint8 0/1/2) exits non-zero; a uint8 0/1 mask gives the same body block as the bool mask; a
+   masks.json whose grids.oct150 affine differs from --work exits non-zero."""
+from __future__ import annotations
+import argparse, json, math, os, shutil, subprocess, sys, time
+from pathlib import Path
+import numpy as np
+from scipy import ndimage
+HERE = Path(__file__).resolve().parents[1]
+
+ap = argparse.ArgumentParser(); ap.add_argument("--out", type=Path, required=True); ap.add_argument("--ref-tree", type=Path, default=None)
+ap.add_argument("--stage", choices=["all", "gen", "check"], default="all")
+a = ap.parse_args(); a.out.mkdir(parents=True, exist_ok=True); t0 = time.time(); R = {}; FAIL = []
+def say(*x): print(*x, f"[{time.time()-t0:.0f}s]", flush=True)
+def check(name, ok, **kv):
+    R[name] = {"pass": bool(ok), **kv}; say(f"[{'PASS' if ok else 'FAIL'}] {name} {kv}")
+    if not ok: FAIL.append(name)
+
+# ------------------------------------------------------------------ synthetic pair (+ every exclusion mask the runs need)
+W = a.out / "work"; RUN = a.out / "run"
+def generate():
+    W.mkdir(exist_ok=True); RUN.mkdir(exist_ok=True)
+    rng = np.random.default_rng(11)
+    def rot(axis, deg):
+        u = np.asarray(axis, float); u /= np.linalg.norm(u); th = math.radians(deg); K = np.array([[0, -u[2], u[1]], [u[2], 0, -u[0]], [-u[1], u[0], 0]])
+        return np.eye(3) + math.sin(th) * K + (1 - math.cos(th)) * K @ K
+    so = (60, 70, 56); A_oct = np.diag([0.15, 0.15, 0.15, 1.0]); A_oct[:3, 3] = [1.0, -2.0, 0.5]
+    sm = (150, 170, 150); A_mri = np.diag([0.08, 0.08, 0.08, 1.0]); A_mri[:3, 3] = [-3.0, -6.0, -3.5]
+    c_o = (A_oct @ np.r_[(np.array(so) - 1) / 2.0, 1])[:3]; c_m = (A_mri @ np.r_[(np.array(sm) - 1) / 2.0, 1])[:3]
+    T = np.eye(4); T[:3, :3] = rot([0.3, 1.0, 0.2], 12.0); T[:3, 3] = c_m - T[:3, :3] @ c_o                     # OCT world -> MRI world
+    waves = [(rng.normal(size=3) * 2.2, rng.uniform(0, 2 * np.pi)) for _ in range(12)]
+    def tex(p):                                                                                                   # smooth texture in MRI world coordinates
+        return sum(np.sin(p @ k + ph) for k, ph in waves) / math.sqrt(len(waves))
+    def ellip(p, s=1.0):
+        q = p - c_m; return (q[..., 0] / (3.3 * s)) ** 2 + (q[..., 1] / (4.2 * s)) ** 2 + (q[..., 2] / (3.0 * s)) ** 2 < 1
+    gi = np.stack(np.meshgrid(*[np.arange(n) for n in sm], indexing="ij"), -1).reshape(-1, 3).astype(float); pm = gi @ A_mri[:3, :3].T + A_mri[:3, 3]
+    tis = ellip(pm).reshape(sm); mri = np.where(tis, 1.0 + 0.3 * tex(pm).reshape(sm), 0.1) + 0.02 * rng.normal(size=sm)
+    tis_thr = tis & (rng.random(sm) > 0.002)                                                                     # threshold-only mask with speckle holes
+    go = np.stack(np.meshgrid(*[np.arange(n) for n in so], indexing="ij"), -1).reshape(-1, 3).astype(float); po = go @ A_oct[:3, :3].T + A_oct[:3, 3]
+    pom = po @ T[:3, :3].T + T[:3, 3]; mask_o = ellip(pom, 0.98).reshape(so)
+    oct150 = np.where(mask_o, 150 + 60 * tex(pom).reshape(so), 40 + 5 * rng.random(so)).astype(np.float32); oct150[5:14, 8:20, 20:34] = 0
+    np.save(W / "oct150.npy", oct150); np.save(W / "oct150_mask.npy", mask_o); np.save(W / "oct150_affine.npy", A_oct)
+    np.save(W / "mri.npy", mri.astype(np.float32)); np.save(W / "mri_affine.npy", A_mri); np.save(W / "mri_tissue.npy", tis_thr)
+    np.save(RUN / "T_oct2mri.npy", T)
+    Tp = T.copy(); Tp[:3, :3] = rot([1, 0, 0], 3.0) @ T[:3, :3]; Tp[:3, 3] = (T @ np.r_[c_o, 1])[:3] + np.array([0.4, 0, 0]) - Tp[:3, :3] @ c_o
+    np.save(RUN / "T_oct2mri_prefine.npy", Tp)
+    Ta = T.copy(); Ra = rot([0, 0, 1], -4.0); Ta[:3, :3] = Ra @ T[:3, :3]; Ta[:3, 3] = (T @ np.r_[c_o, 1])[:3] + np.array([0, 0.5, -0.3]) - Ta[:3, :3] @ c_o
+    np.save(a.out / "T_alt.npy", Ta)
+    np.save(a.out / "oct_excl_empty.npy", np.zeros(so, bool)); np.save(a.out / "mri_excl_empty.npy", np.zeros(sm, bool))
+    ox = mask_o.copy(); ox[: so[0] // 2] = False                                                                     # z+ half of the OCT mask
+    np.save(a.out / "oct_excl_half.npy", ox)
+    mx = np.zeros(sm, bool); pom_h = (np.argwhere(ox) @ A_oct[:3, :3].T + A_oct[:3, 3]) @ T[:3, :3].T + T[:3, 3]
+    ijk = np.rint((pom_h - A_mri[:3, 3]) / 0.08).astype(int); ijk = ijk[((ijk >= 0) & (ijk < np.array(sm))).all(1)]; mx[tuple(ijk.T)] = True
+    mx = ndimage.binary_dilation(mx, iterations=20); np.save(a.out / "mri_excl_half.npy", mx)
+    np.save(a.out / "oct_excl_bad.npy", np.zeros((5, 5, 5), bool))
+    lab = np.zeros(so, np.uint8); lab[mask_o] = 1; lab[ox] = 2; np.save(a.out / "oct_excl_labels.npy", lab)                   # a label map, not a mask
+    np.save(a.out / "oct_excl_half_u8.npy", ox.astype(np.uint8))
+    G = a.out / "grid_mismatch"; G.mkdir(exist_ok=True); np.save(G / "oct_excl_half.npy", ox)
+    A_bad = A_oct.copy(); A_bad[:3, 3] += 0.15
+    json.dump({"grids": {"oct150": {"shape": list(so), "affine": A_bad.tolist()}, "mri": {"shape": list(sm), "affine": A_mri.tolist()}}}, open(G / "masks.json", "w"))
+    say("synthetic pair: OCT mask", int(mask_o.sum()), "MRI tissue", int(tis.sum()))
+
+# ------------------------------------------------------------------ the qc_fine children (name, tree, flags, expect_fail)
+X = lambda f: str(a.out / f)
+RUNS = [("new_default", HERE, (), False)]
+if a.ref_tree is not None: RUNS.append(("ref_default", a.ref_tree, (), False))
+RUNS += [("opt_pose", HERE, ("--pose", f"alt={X('T_alt.npy')}"), False),
+         ("opt_empty_excl", HERE, ("--oct-exclude-mask", X("oct_excl_empty.npy"), "--mri-exclude-mask", X("mri_excl_empty.npy")), False),
+         ("opt_half_excl", HERE, ("--oct-exclude-mask", X("oct_excl_half.npy"), "--mri-exclude-mask", X("mri_excl_half.npy"), "--skip-landscape"), False),
+         ("opt_half_excl_pose", HERE, ("--oct-exclude-mask", X("oct_excl_half.npy"), "--mri-exclude-mask", X("mri_excl_half.npy"), "--skip-landscape", "--pose", f"alt={X('T_alt.npy')}"), False),
+         ("opt_bad_shape", HERE, ("--oct-exclude-mask", X("oct_excl_bad.npy"), "--skip-landscape"), True),
+         ("opt_label_values", HERE, ("--oct-exclude-mask", X("oct_excl_labels.npy"), "--skip-landscape"), True),
+         ("opt_half_u8", HERE, ("--oct-exclude-mask", X("oct_excl_half_u8.npy"), "--mri-exclude-mask", X("mri_excl_half.npy"), "--skip-landscape"), False),
+         ("opt_grid_mismatch", HERE, ("--oct-exclude-mask", X("grid_mismatch/oct_excl_half.npy"), "--skip-landscape"), True)]
+def cmd_of(name, tree, flags):
+    return [sys.executable, str(tree / "scripts/qc_fine.py"), "--work", str(W), "--run", str(RUN), "--out", str(a.out / name), *flags]
+
+if a.stage in ("all", "gen"):
+    generate()
+if a.stage == "gen":
+    import shlex
+    lines = ["#!/bin/bash", "# generated by test_qc_options.py --stage gen: the qc_fine children, one at a time (no python parent)", "export OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=", "fail=0"]
+    for name, tree, flags, expect_fail in RUNS:
+        o = a.out / name
+        lines.append(f"rm -rf {shlex.quote(str(o))}; {' '.join(shlex.quote(c) for c in cmd_of(name, tree, flags))} > {shlex.quote(str(a.out / (name + '.log')))} 2>&1; rc=$?; echo $rc > {shlex.quote(str(a.out / (name + '.rc')))}; echo \"{name} rc $rc\"")
+    lines.append("exit 0   # pass / fail is decided by --stage check")
+    (a.out / "children.sh").write_text("\n".join(lines) + "\n"); say("wrote", a.out / "children.sh", f"({len(RUNS)} qc_fine runs)"); sys.exit(0)
+if a.stage == "all":
+    env = dict(os.environ, OMP_NUM_THREADS="4", CUDA_VISIBLE_DEVICES="")
+    for name, tree, flags, expect_fail in RUNS:
+        shutil.rmtree(a.out / name, ignore_errors=True)
+        p = subprocess.run(cmd_of(name, tree, flags), capture_output=True, text=True, env=env)
+        (a.out / f"{name}.log").write_text(p.stdout + p.stderr); (a.out / f"{name}.rc").write_text(str(p.returncode)); say(f"qc {name} ({tree.name}) rc {p.returncode}")
+        if (p.returncode != 0) != expect_fail: say(p.stdout[-1500:], p.stderr[-2500:])
+
+# ------------------------------------------------------------------ checks (read-only)
+def qc(name):
+    f = a.out / f"{name}.rc"; rc = int(f.read_text().strip()) if f.exists() else 99; o = a.out / name
+    return (json.load(open(o / "qc_fine.json")) if (o / "qc_fine.json").exists() and rc == 0 else None), rc
+def strip(o):
+    if isinstance(o, dict): return {k: strip(v) for k, v in o.items() if not k.startswith("seconds")}
+    if isinstance(o, list): return [strip(v) for v in o]
+    return o
+
+Qd, rc = qc("new_default")
+if rc: check("Q_default_runs", False, rc=rc); json.dump(R, open(a.out / "test_qc_options.json", "w"), indent=1); print(f"FAILED: {FAIL}"); sys.exit(1)
+if a.ref_tree is not None:
+    Qr, rcr = qc("ref_default")
+    same = rcr == 0 and json.dumps(strip(Qr), sort_keys=True) == json.dumps(strip(Qd), sort_keys=True)
