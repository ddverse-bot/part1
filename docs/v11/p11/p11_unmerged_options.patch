+spec = (((yy - N0 / 2) / (0.46 * N0)) ** 2 + ((xx - N1 / 2) / (0.46 * N1)) ** 2) < 1; F_true -= F_true[spec].mean()
+vol6 = np.clip(anat * speck * np.exp(F_true)[:, :, None], 1, 60000).astype(np.float16); del anat, speck
+m6 = np.repeat(spec[:, :, None], NS, 2); vol6[~m6] = 0; vol6[100:120, 200:230, :] = 0; zeros6 = vol6 == 0
+L0, N0m = octnorm.enface_log_maps(vol6, m6, 2); before_true = octnorm.tile_field_2d(L0, N0m, P0, P1)[3]["log_std"]
+v6 = vol6.copy(); info6 = octnorm.tile_flatfield_inplace(v6, m6, sect_axis=2, band_vox=(15.0, 100.0))
+Pest = info6.get("periods_vox") or [None, None]; corr = None; after_true = None
+if info6["applied"]:
+    nb0, nb1 = info6["field"]["nb"]; F2 = np.asarray(info6["field_log"])
+    est = F2[np.floor(((np.arange(N0) / Pest[0]) % 1) * nb0).astype(int) % nb0][:, np.floor(((np.arange(N1) / Pest[1]) % 1) * nb1).astype(int) % nb1]
+    corr = float(np.corrcoef(est[spec], F_true[spec])[0, 1])
+    L1, N1m = octnorm.enface_log_maps(v6, m6, 2); after_true = octnorm.tile_field_2d(L1, N1m, P0, P1)[3]["log_std"]
+ok6 = info6["applied"] and abs(Pest[0] / P0 - 1) < 0.01 and abs(Pest[1] / P1 - 1) < 0.01 and corr >= 0.9 and after_true <= 0.3 * before_true and np.array_equal(v6 == 0, zeros6)
+check("T6a_tile_estimated", ok6, periods=Pest, field_corr=corr, field_log_std_at_true_periods_before_after=[before_true, after_true], separable_R2=info6["field"]["separable_R2"],
+      chosen=[info6["estimate"]["axis_a"].get("chosen"), info6["estimate"]["axis_b"].get("chosen")])
+v6t = np.ascontiguousarray(np.moveaxis(vol6, 2, 0)); m6t = np.ascontiguousarray(np.moveaxis(m6, 2, 0))
+info6t = octnorm.tile_flatfield_inplace(v6t, m6t, sect_axis=0, band_vox=(15.0, 100.0), residual=False)
+dmax = float((np.abs(np.moveaxis(v6t, 0, 2).astype(np.float32) - v6.astype(np.float32)) / np.maximum(v6.astype(np.float32), 1.0)).max())
+check("T6b_tile_sect_axis0_equals_axis2", info6t["applied"] and np.allclose(info6t["periods_vox"], info6["periods_vox"], atol=1e-9) and np.allclose(info6t["field_log"], info6["field_log"], atol=1e-4)
+      and dmax <= 1e-3 and np.array_equal(np.moveaxis(v6t, 0, 2) == 0, zeros6), periods=info6t.get("periods_vox"), max_rel_diff=dmax)
+v6g = vol6.copy(); info6g = octnorm.tile_flatfield_inplace(v6g, m6, sect_axis=2, periods_vox=info6["periods_vox"], residual=False)
+check("T6c_tile_given_periods", info6g["periods_source"] == "given" and np.array_equal(v6g, v6))
+# T6d: remove the axis-0 marginal of the tile (what a per-slice normalisation along en-face axis 0 does): axis 0 must borrow axis 1's period
+marg0 = np.array([F_true[i][spec[i]].mean() if spec[i].any() else 0.0 for i in range(N0)])
+v6d = np.clip(vol6.astype(np.float32) * np.exp(-marg0)[:, None, None], 0, 60000).astype(np.float16); v6d[zeros6] = 0
+info6d = octnorm.tile_flatfield_inplace(v6d, m6, sect_axis=2, band_vox=(15.0, 100.0), residual=False)
