+def plane_medians(vol: np.ndarray, axis: int, mask: np.ndarray | None = None, min_count: int = 2000):
+    """Exact median of the valid voxels (vol > 0, & mask) of every plane along ``axis`` (planes with <= min_count voxels -> nan)."""
